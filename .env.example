# Copy this file to .env.local and fill in real values, or just run
# `npm run dev` / `npm run setup` and the terminal will ask for them.
# .env.local is gitignored — never commit real keys.

# Required. Main AI for reading ideas and ranking results. console.groq.com/keys
GROQ_API_KEY=

# Optional. Backup AI if Groq is down. aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional but recommended. Fine-grained token, public repos read-only.
# Raises GitHub's search limit and enables searching inside SKILL.md / rule files.
GITHUB_TOKEN=
