# Copy this file to .env.local (exact name, no extra extension) and fill
# in real values. .env.local is gitignored — never commit real keys.

# Which matching provider lib/matching/matchSkills.js uses.
# "mock" (default, no key needed) or "groq".
MATCHING_PROVIDER=mock

# Only used when MATCHING_PROVIDER=mock. Lets you exercise each frontend
# state on demand: success (default) | empty | error | slow
# MOCK_MATCH_MODE=success

# Required when MATCHING_PROVIDER=groq. https://console.groq.com/keys
# GROQ_API_KEY=

# Optional override, defaults to openai/gpt-oss-20b (supports strict
# json_schema structured outputs). openai/gpt-oss-120b and
# qwen/qwen3.8-27b also support strict mode as of 2026-09-28.
# GROQ_MODEL=openai/gpt-oss-20b

# Max candidates sent to the matching provider per search, after the local
# pre-filter (category/keyword scoring, or platform hard filter). Keeps
# the Groq request under its free-tier tokens/minute cap as the dataset
# grows. Defaults to 25.
# MATCH_CANDIDATE_LIMIT=25
